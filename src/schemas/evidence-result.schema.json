{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidenceResult",
  "type": "object",
  "required": ["evidenceState", "provenance", "missingEvidence"],
  "properties": {
    "evidenceState": {
      "type": "string",
      "enum": ["VERIFIED", "CORROBORATED", "REPORTED", "CONFLICTING", "UNKNOWN"]
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sourceId", "publicationDate", "retrievalDate"]
      }
    },
    "missingEvidence": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
