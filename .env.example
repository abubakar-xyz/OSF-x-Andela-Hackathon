# Wazi — environment.  Do not commit real values.
#
# Wazi runs WITHOUT any of these: voice falls back to the browser speech
# engine, every tool runs locally against the cached Country Pack, and
# the interface says which engine is actually running.
#
# Set these to turn on the hosted realtime path (DESIGN.md §23.3-§23.5).

# ─── The key. Server-side only; it must never reach a browser. ────────
# Get one at https://aistudio.google.com/apikey
WAZI_API_KEY=

# ─── Models ───────────────────────────────────────────────────────────
# Defaults are the current Live models per Google's own
# gemini-live-api-dev skill, vendored at
# .claude/skills/gemini-live-api-dev/SKILL.md. Override only to pin.
#
#   gemini-3.8-live                    low-latency conversation; async
#                                      function calling is the default
#   gemini-3.8-live-extended-thinking  background reasoning during a live
#                                      call, speaking natural fillers
#                                      while async tools run. Requires
#                                      NON_BLOCKING on every declaration
#                                      and interaction_status for idle.
WAZI_HOST_MODEL=gemini-3.8-live
WAZI_DEEP_MODEL=gemini-3.8-live-extended-thinking
WAZI_WORKER_MODEL=gemini-3-flash

# thinking_level for the extended-thinking model: low | medium | high
# (MINIMAL is not supported on that model).
WAZI_THINKING_LEVEL=low

# Set to 0 to use the plain low-latency model instead of the
# extended-thinking one.
WAZI_USE_DEEP=1

# ─── Relay ────────────────────────────────────────────────────────────
WAZI_RELAY_PORT=8787
WAZI_PACK=ke-siaya

# The browser reads this, and ONLY this. It is a WebSocket URL for our
# own relay — never a model provider, because tools execute server-side.
# A client that runs its own tools is a client that decides what counts
# as evidence.
WAZI_RELAY_URL=
