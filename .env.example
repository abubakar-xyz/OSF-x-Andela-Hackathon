# Wazi — environment
#
# This build needs NO credentials. Voice runs on the browser's own speech
# engine and every tool executes locally against the cached Country Pack.
# The file exists so the shape is documented for whoever wires the hosted
# realtime path described in DESIGN.md §23.3-§23.5.
#
# Do not commit real values.

# The WebSocket relay Wazi connects to. Never a model provider directly:
# tools execute server-side, because a client that runs its own tools is a
# client that decides what counts as evidence. DESIGN.md §23.3
WAZI_RELAY_URL=

# Model selection is by CAPABILITY, not by name. Read the real model list
# in your own API project first and record the exact IDs and the date in
# DECISIONS.md. Never ship a model ID nobody has called. DESIGN.md §23.4
#
# host   — bidirectional streaming audio, image frames in, server-side VAD
#          with interruption, input+output transcription, function calling,
#          multilingual, session resumption, ephemeral tokens
# worker — strict JSON-schema structured output, tool calling, search
#          grounding with returned citations, temperature 0
WAZI_HOST_MODEL=
WAZI_WORKER_MODEL=
WAZI_CHALLENGER_MODEL=

# Server-side only. Must never reach the browser.
WAZI_API_KEY=
